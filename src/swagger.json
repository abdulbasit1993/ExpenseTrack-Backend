{
  "openapi": "3.0.3",
  "info": {
    "title": "Expense Tracker API",
    "version": "1.0.0",
    "description": "API documentation for the Expense Tracker app."
  },
  "tags": [
    { "name": "Authentication" },
    { "name": "Categories" },
    { "name": "Transactions" },
    { "name": "Dashboard" },
    { "name": "User" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api": {
      "get": {
        "summary": "API welcome message",
        "security": [],
        "responses": {
          "200": {
            "description": "Welcome message",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessMessage" }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a user",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": {
            "description": "Email is already registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log in",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get the authenticated user",
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/categories/add": {
      "post": {
        "tags": ["Categories"],
        "summary": "Create a custom category",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCategoryInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CategoryResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "Duplicate category",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "List default and user categories",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": { "type": "string", "enum": ["income", "expense"] }
          },
          {
            "name": "includeArchived",
            "in": "query",
            "description": "Include archived custom categories.",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "Categories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryListResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/categories/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "get": {
        "tags": ["Categories"],
        "summary": "Get a category",
        "responses": {
          "200": {
            "description": "Category",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CategoryResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["Categories"],
        "summary": "Update a custom category",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateCategoryInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated category",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CategoryResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Duplicate category",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "Delete a custom category",
        "responses": {
          "200": {
            "description": "Category deleted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessMessage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Category is used by transactions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/transactions/add": {
      "post": {
        "tags": ["Transactions"],
        "summary": "Create a transaction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transaction created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransactionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "tags": ["Transactions"],
        "summary": "List the authenticated user's transactions",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": { "type": "string", "enum": ["income", "expense"] }
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" }
          },
          {
            "name": "fromDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "toDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions and pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionListResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/transactions/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/ObjectId" }],
      "get": {
        "tags": ["Transactions"],
        "summary": "Get a transaction",
        "responses": {
          "200": {
            "description": "Transaction",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransactionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["Transactions"],
        "summary": "Update a transaction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTransactionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated transaction",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransactionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Transactions"],
        "summary": "Delete a transaction",
        "responses": {
          "200": {
            "description": "Transaction deleted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessMessage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get the authenticated user's dashboard",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "Year for the monthly figures. Defaults to the current year.",
            "schema": { "type": "integer", "minimum": 1920, "maximum": 2100 }
          },
          {
            "name": "month",
            "in": "query",
            "description": "Month as a number (1-12) for the monthly figures. Defaults to the current month.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 12 }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of recent transactions to return.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard summary, selected month, and recent transactions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/user/preferences": {
      "patch": {
        "tags": ["User"],
        "summary": "Update the authenticated user's preferences (monthlyBudget, currency)",
        "description": "Partially updates the authenticated user's preferences. Send only the fields you want to change; at least one of monthlyBudget or currency is required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserPreferencesInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preferences updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPreferencesResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/user/profile": {
      "put": {
        "tags": ["User"],
        "summary": "Update the authenticated user's profile",
        "description": "Updates first name, last name, and/or profile image. All fields are optional — send only what you want to change. The profile image is uploaded as multipart/form-data and stored in Cloudinary.",
        "consumes": ["multipart/form-data"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string",
                    "description": "Updated first name.",
                    "example": "John"
                  },
                  "lastName": {
                    "type": "string",
                    "description": "Updated last name.",
                    "example": "Doe"
                  },
                  "profileImage": {
                    "type": "string",
                    "format": "binary",
                    "description": "Profile image file (JPEG, PNG, WebP, GIF; max 5 MB)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Paste the JWT returned by register or login. Swagger UI sends it as `Authorization: Bearer <token>`."
      }
    },
    "parameters": {
      "ObjectId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "example": "507f1f77bcf86cd799439011"
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Invalid request data",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid, or expired bearer token",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Requested resource was not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "ServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "RegisterInput": {
        "type": "object",
        "required": ["firstName", "lastName", "email", "password"],
        "properties": {
          "firstName": { "type": "string", "example": "John" },
          "lastName": { "type": "string", "example": "Doe" },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "password123"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password123"
          }
        }
      },
      "CreateCategoryInput": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "maxLength": 50, "example": "Groceries" },
          "type": {
            "type": "string",
            "enum": ["income", "expense"],
            "example": "expense"
          },
          "icon": {
            "type": "string",
            "maxLength": 50,
            "example": "shopping-cart"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "example": "#22C55E"
          }
        }
      },
      "UpdateCategoryInput": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "maxLength": 50 },
          "type": { "type": "string", "enum": ["income", "expense"] },
          "icon": { "type": "string", "maxLength": 50 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "isArchived": { "type": "boolean" }
        }
      },
      "CreateTransactionInput": {
        "type": "object",
        "required": ["title", "categoryId", "type", "amount", "date"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "example": "Weekly groceries"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "example": "Groceries for the week"
          },
          "categoryId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$",
            "example": "507f1f77bcf86cd799439011"
          },
          "type": {
            "type": "string",
            "enum": ["income", "expense"],
            "example": "expense"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "example": 2450.5
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-08-02"
          }
        }
      },
      "UpdateTransactionInput": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": { "type": "string", "maxLength": 100 },
          "description": { "type": "string", "maxLength": 1000 },
          "categoryId": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" },
          "type": { "type": "string", "enum": ["income", "expense"] },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "date": { "type": "string", "format": "date" }
        }
      },
      "UpdateUserPreferencesInput": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "monthlyBudget": {
            "type": "number",
            "description": "New monthly budget amount",
            "minimum": 0,
            "example": 3500
          },
          "currency": {
            "type": "string",
            "description": "Currency code (e.g. USD, EUR, PKR)",
            "example": "USD",
            "pattern": "^[A-Z]{3}$"
          }
        }
      },
      "UpdateProfileInput": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "firstName": {
            "type": "string",
            "maxLength": 50,
            "description": "Updated first name.",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "maxLength": 50,
            "description": "Updated last name.",
            "example": "Doe"
          },
          "profileImage": {
            "type": "string",
            "format": "binary",
            "description": "Profile image file (JPEG, PNG, WebP, GIF; max 5 MB)."
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "monthlyBudget": { "type": "number" },
          "currency": { "type": "string", "example": "PKR" },
          "profileImage": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["income", "expense"] },
          "icon": { "type": "string" },
          "color": { "type": "string" },
          "isDefault": { "type": "boolean" },
          "isArchived": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "categoryId": { "type": "string" },
          "type": { "type": "string", "enum": ["income", "expense"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "amount": { "type": "number" },
          "note": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "SuccessMessage": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      },
      "AuthResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessMessage" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "user": { "$ref": "#/components/schemas/User" },
                  "token": { "type": "string" }
                }
              }
            }
          }
        ]
      },
      "UserResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessMessage" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "user": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          }
        ]
      },
      "UserPreferencesResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessMessage" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "user": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          }
        ]
      },
      "CategoryResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessMessage" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "category": { "$ref": "#/components/schemas/Category" }
                }
              }
            }
          }
        ]
      },
      "CategoryListResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessMessage" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "categories": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Category" }
                  }
                }
              }
            }
          }
        ]
      },
      "TransactionResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessMessage" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "transaction": { "$ref": "#/components/schemas/Transaction" }
                }
              }
            }
          }
        ]
      },
      "TransactionListResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessMessage" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "transactions": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Transaction" }
                  },
                  "pagination": {
                    "type": "object",
                    "properties": {
                      "page": { "type": "integer" },
                      "limit": { "type": "integer" },
                      "total": { "type": "integer" },
                      "totalPages": { "type": "integer" }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "DashboardSummary": {
        "type": "object",
        "properties": {
          "currentBalance": {
            "type": "number",
            "description": "All-time income minus all-time expenses.",
            "example": 15230.75
          },
          "totalIncome": {
            "type": "number",
            "description": "All-time income total.",
            "example": 50000
          },
          "totalExpenses": {
            "type": "number",
            "description": "All-time expense total.",
            "example": 34769.25
          },
          "monthlyBudget": {
            "type": "number",
            "description": "User's budget for the selected month.",
            "example": 30000
          },
          "monthlySpent": {
            "type": "number",
            "description": "Total spent in the selected month.",
            "example": 12450.5
          }
        }
      },
      "DashboardMonth": {
        "type": "object",
        "properties": {
          "year": { "type": "integer", "example": 2026 },
          "month": { "type": "integer", "minimum": 1, "maximum": 12, "example": 8 },
          "label": { "type": "string", "example": "August 2026" }
        }
      },
      "DashboardCategory": {
        "type": "object",
        "nullable": true,
        "description": "Category of a recent transaction, or null when it has none.",
        "properties": {
          "_id": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "name": { "type": "string", "example": "Groceries" },
          "icon": { "type": "string", "example": "shopping-cart" }
        }
      },
      "RecentTransaction": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "title": { "type": "string", "example": "Weekly groceries" },
          "type": {
            "type": "string",
            "enum": ["income", "expense"],
            "example": "expense"
          },
          "amount": { "type": "number", "example": 2450.5 },
          "date": { "type": "string", "format": "date-time" },
          "category": { "$ref": "#/components/schemas/DashboardCategory" }
        }
      },
      "DashboardResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/SuccessMessage" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "summary": {
                    "$ref": "#/components/schemas/DashboardSummary"
                  },
                  "month": { "$ref": "#/components/schemas/DashboardMonth" },
                  "recentTransactions": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/RecentTransaction"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
